{
  "installCommand": "pip install --no-cache-dir -r requirements-vercel.txt && sh scripts/trim-bundle.sh",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "templates/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
